{
  "name": "hello-api",
  "type": "service",
  "version": "0.1.0",
  "language": "Ballerina",
  "buildpack": "docker",
  "appPath": "hello-api",
  "entrypoint": "deployment/service",
  "exposure": "internet",
  "stories": [
    1
  ],
  "description": "The bare-minimum hello-world API: a single authenticated endpoint that returns a fixed greeting to confirm the service is reachable and the caller is signed in. Holds no data, exposes no other endpoint, and does not personalize or configure the greeting.",
  "dependencies": [
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "p70-bare-minimum-1c67d036",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "exposesAPI": {
    "auth": "end-user-required"
  },
  "skillsPinned": [
    "openapi-conventions",
    "ballerina",
    "thunder-authentication",
    "api-management"
  ]
}
